# Optional test configuration. Copy to .env.local; never commit real values.
# The Console page server needs no platform credential or identity configuration.
# Login and private APIs belong to the platform application edge. See README.md.

# Direct live contract tests use an issued user or service-account API key.
# Set RUN_LIVE_CONTRACT_TESTS=1 in the invoking shell to opt in.
PLATFORM_BASE_URL=http://127.0.0.1:8080
TEST_API_KEY=

# The live browser suite uses a named platform account, not the API key above.
# Configure its platform public origin as http://127.0.0.1:3200.
# Set RUN_LIVE_CONSOLE_TESTS=1 in the invoking shell to opt in to model spending.
# LIVE_LOGIN_NAME=
# LIVE_LOGIN_PASSWORD=
# MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8090

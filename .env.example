# Copy to .env.local for `pnpm dev`. Never commit real values.

# Base URL of the managed-agent-platform control plane.
PLATFORM_BASE_URL=http://localhost:8080

# The control plane management key (CONTROLPLANE_API_KEY on the platform).
# Server-side only — it never reaches the browser.
#
# With IDENTITY_MODE=oidc this is no longer what browser-initiated calls carry:
# they carry the signed-in operator's own token. It stays as the dedicated
# service credential for `GET /api/health?deep=1`, the one console-to-platform
# call that has no user to act as.
PLATFORM_API_KEY=

# Optional: enables the console login gate when set.
# CONSOLE_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: browser sign-in against an OIDC provider (plan 08).
#
# Unset or `disabled` leaves the console exactly as it is today. The names are
# the platform's own, and two values must agree across the two processes:
# IDENTITY_OIDC_ISSUER, and the console's client id — which is what the
# platform must be configured to expect as its IDENTITY_OIDC_AUDIENCE, because
# an ID token's `aud` is the relying party's client id.
#
# The platform's third mode, `trusted_proxy`, is not implemented here.
# IDENTITY_MODE=oidc

# Issuer identifier. https, or http to a loopback host; no query, no fragment.
# IDENTITY_OIDC_ISSUER=http://localhost:8000

# The console's OAuth client. Also the platform's IDENTITY_OIDC_AUDIENCE.
# IDENTITY_OIDC_CLIENT_ID=

# Omit for a public client; PKCE is used either way.
# IDENTITY_OIDC_CLIENT_SECRET=

# Optional: absolute callback URL. Derived from the request when unset.
# IDENTITY_OIDC_REDIRECT_URL=https://console.example.com/api/auth/callback

# Optional: space- or comma-separated. Must include `openid`.
# IDENTITY_OIDC_SCOPES=openid profile email
